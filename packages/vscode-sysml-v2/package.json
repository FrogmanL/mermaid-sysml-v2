{
  "name": "vscode-sysml-v2",
  "displayName": "SysML v2 Preview",
  "description": "Renders SysML v2 diagrams (via mermaid-sysml-v2): sysml-v2 fenced blocks in VS Code's Markdown preview, and a live preview panel for .sysml files.",
  "version": "0.3.0",
  "publisher": "unpublished",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrogmanL/mermaid-sysml-v2.git",
    "directory": "packages/vscode-sysml-v2"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sysml",
    "sysml-v2",
    "mermaid",
    "markdown",
    "mbse"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/preview/index.js"
    ],
    "commands": [
      {
        "command": "sysml-v2.openPreview",
        "title": "SysML v2: Open Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sysml-v2.openPreview",
          "when": "resourceExtname == .sysml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "sysml-v2.openPreview",
          "when": "resourceExtname == .sysml",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "sysml-v2.openPreview",
          "when": "editorLangId == sysml || resourceExtname == .sysml"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "mermaid": "^11.4.1",
    "mermaid-sysml-v2": "*"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.5",
    "markdown-it": "^14.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
