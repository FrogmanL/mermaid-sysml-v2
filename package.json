{
  "name": "mermaid-sysml-v2-workspace",
  "private": true,
  "description": "Workspace root for mermaid-sysml-v2 (the Mermaid diagram plugin) and vscode-sysml-v2 (its VS Code extension).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build -w mermaid-sysml-v2",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
